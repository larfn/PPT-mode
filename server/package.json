{
  "name": "ppt-ai-addin-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build:exe": "pkg . --targets node24-win-x64 --output ../dist-exe/ppt-ai-addin.exe",
